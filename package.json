{
  "name": "ash-run-84",
  "version": "0.1.1",
  "description": "Ash Run '84 turn-based tactics roguelite prototype built with Phaser and Electron.",
  "author": "OpenAI Codex",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start-electron.mjs --profile=production",
    "start:dev-build": "node scripts/start-electron.mjs --profile=development",
    "build": "node scripts/build.mjs --profile=production",
    "build:prod": "node scripts/build.mjs --profile=production",
    "build:dev": "node scripts/build.mjs --profile=development",
    "check:unused": "knip --include dependencies,unlisted,exports,files",
    "assets:preload": "node scripts/generate-asset-preload-manifest.mjs",
    "sfx:generate": "node scripts/generate-sfx.mjs",
    "sprites:sheets": "node scripts/generate-sprite-sheet-manifest.mjs",
    "sprites:variants": "node scripts/generate-sprite-variants.mjs",
    "maps:manifest": "node scripts/generate-map-manifest.mjs",
    "test": "node scripts/generate-asset-preload-manifest.mjs && node scripts/generate-map-manifest.mjs && node --test",
    "test:playthrough": "node scripts/full-playthrough-check.mjs",
    "test:ui": "playwright test",
    "test:ui:prod": "playwright test --config=playwright.production.config.js",
    "test:package:profiles": "node scripts/packaged-profile-smoke.mjs",
    "test:ui:update": "playwright test --update-snapshots",
    "package": "node scripts/package.mjs production",
    "package:prod": "node scripts/package.mjs production",
    "package:dev": "node scripts/package.mjs development"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.12",
    "knip": "^6.6.0",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.ashrun84.game.alpha",
    "productName": "Ash Run '84 Alpha",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist/map-resources/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "win": {
      "icon": "build/icon.png",
      "target": "nsis",
      "signAndEditExecutable": false
    }
  }
}
